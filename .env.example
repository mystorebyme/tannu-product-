# ============================================================
# Liksha ecommerce — saari env variables ka template
# Asli keys yahan NAHI daalte. Production me hosting dashboard se set karein.
# ============================================================

# ---- Storefront (apps/web) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_UPI_ID=likshaclothing@upi
ADMIN_API_TOKEN=change-me-in-production

# ---- Payments (third party only) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Admin (apps/admin) ----
ADMIN_EMAIL=admin@likshaclothing.com
ADMIN_PASSWORD=change-me-before-go-live
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32
NEXT_PUBLIC_STORE_URL=http://localhost:3000

# ---- API (apps/api) ----
PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
LOG_LEVEL=info

# ---- Notifications (optional in Phase 1) ----
RESEND_API_KEY=
EMAIL_FROM="Liksha Clothing <orders@likshaclothing.com>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
