# ============================================================
# Liksha ecommerce — saari env variables ka template
# Asli keys yahan NAHI daalte. Production me hosting dashboard se set karein.
# ============================================================

# ---- Storefront (apps/web) ----
# apna domain (deploy ke baad) — WhatsApp/invoice/canonical links isi se bante hain
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Payment yahan aata hai (UPI). Owner Google Sheet se bhi badal sakta hai.
STORE_UPI_ID=dhakadgourav@fam
STORE_UPI_NAME=Designer Clothing
ADMIN_API_TOKEN=change-me-in-production

# ---- Database (R40 se OPTIONAL — orders Google Sheet me rehte hain) ----
# DATABASE_URL ab zaroori NAHI: GOOGLE_SHEETS_WEBAPP_URL/TOKEN set hain to orders
# sheet me save hote hain (backend "sheet" — owner rule: "Supabase nahi, only sheet").
# Postgres sirf dev/backup ke liye (ORDERS_STORE=postgres force karke). Dono na ho
# to data JSON fallback me jaata hai (ephemeral — production ke liye nahi).
DATABASE_URL=
DATABASE_URL_POOLED=
DB_POOL_MAX=

# ---- Google Sheets (owner ka control panel, DB ke upar) ----
# scripts/google-apps-script/liksha-sheets.gs deploy karke jo /exec URL milta hai.
# Setup: docs/09-devops/google-sheets.md
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_TOKEN=
# Sheet → site real-time tuning (R35). Defaults kaafi hain; badalna ho tabhi bharein.
# Apps Script ka doGet cold start par 1-4s leta hai — timeout usse chhota mat rakhein,
# warna read hamesha fail hoga aur site default UPI dikhaayegi.
SHEET_READ_TIMEOUT_MS=4000
# owner ka sheet edit itni der me site par (payment page ?fresh=1 se turant padhta hai)
SHEET_SETTINGS_TTL_MS=10000
# sheet down ho to last good value itni der tak chalegi (defaults par nahi jaayenge)
SHEET_SETTINGS_STALE_MS=600000
# Fallback: Settings tab ka "Publish to web" CSV (Apps Script na ho to). Google ise
# ~5 minute cache karta hai — real-time chahiye to upar wala /exec URL hi use karein.
GOOGLE_SHEETS_SETTINGS_CSV_URL=
# Selftest endpoint (key-gated) — `/api/sheet-selftest?key=...`
SHEET_SELFTEST_KEY=
# UPI return callback ka secret (order auto-confirm token). Na do to ADMIN_API_TOKEN use hota hai.
# Ise badalne par purane UPI links invalid ho jaate hain (customer UTR se confirm kar sakta hai).
UPI_RETURN_SECRET=
# Admin panel ka public link (sheet ke Settings → admin_url me bhi daal sakte hain)
ADMIN_PANEL_URL=
# GitHub Pages build ke liye (repo → Settings → Variables → Actions me STORE_API_URL)
# Set ho to static site ka checkout/payment/tracking seedha Render API par jaata hai.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_LIVE_STORE_URL=https://liksha-clothing.vercel.app
# In origins ke ilawa bhi CORS allow karna ho (comma separated). Apni site
# (NEXT_PUBLIC_SITE_URL), GitHub Pages origin, *.netlify.app aur *.onrender.com
# by default allowed hain.
CORS_ALLOWED_ORIGINS=

# ---- Contact form ("Send us a message") ----
# Message pehle DB me save hota hai, phir Google Sheet (Messages tab) me jaata hai —
# site par support EMAIL kahin dikhta nahi (owner rule). Email notification optional
# hai: sirf tab chalta hai jab niche koi owner address diya ho.
CONTACT_EMAIL=
# Chahein to FormSubmit band karke apna endpoint dein (Google Apps Script / Zapier / Make)
CONTACT_FORM_ENDPOINT=
# Resend (free 3,000/month) set ho to wahi use hota hai, FormSubmit skip
RESEND_API_KEY=
EMAIL_FROM=Liksha Website <onboarding@resend.dev>

# ---- Phone OTP (Firebase) ----
# Firebase console -> Project settings -> Your apps (Web) se ye values milti hain.
# Ye public hain (browser me jaati hain), koi secret nahi.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Server-side token verification (api key yahan bhi chahiye)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Order place karne ke liye verified phone zaroori (1 = on, 0 = off). Firebase set hone par default on.
REQUIRE_PHONE_OTP=1
# Checkout phone-token ka signing key (openssl rand -hex 32)
OTP_TOKEN_SECRET=
# Local testing: Firebase ke bina dev OTP (production me "off" rakhein)
OTP_DEV_MODE=on

# ---- GST invoice ----
# Apna GSTIN yahan daaliye — invoice PDF/HTML par chhapta hai.
SELLER_GSTIN=
# invoice par email nahi chhapta (owner rule) — sirf internal record ke liye
SELLER_EMAIL=
SELLER_PHONE=+91 9879219630
GST_HSN=6204

# ---- Payments ----
# Koi third-party gateway nahi (owner rule) — sirf UPI (STORE_UPI_ID).
# Purane routes (/api/webhooks/razorpay) dormant hain, inhe set karne ki zarurat nahi.

# ---- Admin (apps/admin) ----
ADMIN_EMAIL=admin@likshaclothing.com
ADMIN_PASSWORD=change-me-before-go-live
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32
NEXT_PUBLIC_STORE_URL=http://localhost:3000
# admin se invoice/receipt link banane ke liye
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# ---- API (apps/api) ----
PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
LOG_LEVEL=info

# ---- Notifications (optional in Phase 1) ----
RESEND_API_KEY=
EMAIL_FROM="Liksha Clothing <orders@likshaclothing.com>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
