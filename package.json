{
  "name": "liksha-ecommerce",
  "private": true,
  "version": "0.1.0",
  "description": "Liksha Clothing - production-grade ecommerce monorepo (storefront + admin + api)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @liksha/web",
    "dev:web": "npm run dev --workspace @liksha/web",
    "dev:admin": "npm run dev --workspace @liksha/admin",
    "dev:api": "npm run dev --workspace @liksha/api",
    "build": "npm run build --workspace @liksha/web",
    "build:all": "npm run build --workspace @liksha/web && npm run build --workspace @liksha/admin && npm run build --workspace @liksha/api",
    "start": "npm run start --workspace @liksha/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test tests/unit/*.test.ts",
    "catalog:build": "node scripts/build-catalog.mjs",
    "setup": "bash scripts/setup.sh",
    "build:web": "npm run build --workspace @liksha/web",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:smoke": "node tests/e2e/smoke.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:integration",
    "catalog:verify": "node scripts/verify-catalog.mjs",
    "catalog:sync-live": "npm run catalog:sync",
    "catalog:sync": "node scripts/catalog-sync/fetch-live.mjs && npm run catalog:build"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
